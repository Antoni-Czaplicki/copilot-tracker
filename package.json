{
  "name": "copilot-tracker-monorepo",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm -r build",
    "compile": "pnpm --filter ./apps/extension compile",
    "db:generate": "pnpm --filter @copilot-tracker/web db:generate",
    "db:migrate": "pnpm --filter @copilot-tracker/web db:migrate",
    "db:studio": "pnpm --filter @copilot-tracker/web db:studio",
    "dev:web": "pnpm --filter @copilot-tracker/web dev",
    "format": "prettier . --write",
    "lint": "pnpm -r lint",
    "package:extension": "pnpm --filter ./apps/extension package",
    "smoke:production": "node scripts/smoke-production.mjs",
    "test": "pnpm test:smoke && pnpm test:web && pnpm --filter ./apps/extension test",
    "test:smoke": "node --test scripts/*.test.mjs",
    "test:web": "pnpm --filter @copilot-tracker/web test",
    "typecheck": "pnpm -r typecheck"
  },
  "prettier": "@solvro/config/prettier",
  "devDependencies": {
    "@next/eslint-plugin-next": "^16.2.12",
    "@solvro/config": "^2.3.4",
    "@types/node": "~26.1.2",
    "eslint": "^10.8.0",
    "prettier": "^3.9.6",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.65.0"
  },
  "packageManager": "pnpm@11.7.0"
}
