{
  "name": "copilot-tracker",
  "displayName": "Copilot tracker",
  "version": "0.0.4",
  "description": "Track your copilot tokens per branch or assign them manually",
  "categories": [
    "Other"
  ],
  "keywords": [
    "github copilot",
    "copilot",
    "tokens",
    "usage",
    "telemetry",
    "opentelemetry",
    "azure devops"
  ],
  "galleryBanner": {
    "color": "#1e1e1e",
    "theme": "dark"
  },
  "publisher": "antoni-czaplicki",
  "license": "MIT",
  "homepage": "https://github.com/Antoni-Czaplicki/copilot-tracker#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/Antoni-Czaplicki/copilot-tracker.git",
    "directory": "apps/extension"
  },
  "bugs": {
    "url": "https://github.com/Antoni-Czaplicki/copilot-tracker/issues"
  },
  "main": "./out/extension.js",
  "scripts": {
    "build": "pnpm run compile",
    "bundle": "esbuild ./src/extension.ts --bundle --platform=node --format=cjs --external:vscode --outfile=out/extension.js --target=node20",
    "compile": "tsc -p ./",
    "lint": "eslint src",
    "package": "node ../../scripts/package-extension.mjs",
    "pretest": "pnpm run compile && pnpm run lint",
    "test": "vscode-test",
    "typecheck": "tsc -p ./ --noEmit",
    "vscode:prepublish": "pnpm run bundle",
    "watch": "tsc -watch -p ./"
  },
  "contributes": {
    "commands": [
      {
        "command": "copilot-tracker.setTask",
        "title": "Set Current Task",
        "category": "Copilot Tracker"
      },
      {
        "command": "copilot-tracker.useBranchTask",
        "title": "Use Branch as Task",
        "category": "Copilot Tracker"
      },
      {
        "command": "copilot-tracker.syncCopilotSessions",
        "title": "Sync Copilot OTel Now",
        "category": "Copilot Tracker"
      },
      {
        "command": "copilot-tracker.signIn",
        "title": "Sign In",
        "category": "Copilot Tracker"
      },
      {
        "command": "copilot-tracker.openDashboard",
        "title": "Open Dashboard",
        "category": "Copilot Tracker"
      },
      {
        "command": "copilot-tracker.showContext",
        "title": "Show Current Context",
        "category": "Copilot Tracker"
      },
      {
        "command": "copilot-tracker.showLogs",
        "title": "Show Logs",
        "category": "Copilot Tracker"
      }
    ],
    "configuration": {
      "title": "Copilot Tracker",
      "properties": {
        "copilot-tracker.serverUrl": {
          "type": "string",
          "default": "http://localhost:3737",
          "description": "Copilot Tracker server URL. Set this in user settings; workspace values are ignored for token safety."
        },
        "copilot-tracker.otelHttpPort": {
          "type": "number",
          "default": 4318,
          "minimum": 1,
          "maximum": 65535,
          "description": "Local loopback OTLP/HTTP receiver port. GitHub Copilot Chat reads OTel settings on window reload, so this port stays stable across extension restarts."
        },
        "copilot-tracker.showCurrentSessionTokensInStatusBar": {
          "type": "boolean",
          "default": true,
          "description": "Show current Copilot chat session token usage in the status bar."
        },
        "copilot-tracker.taskBranchBaseBranches": {
          "type": "array",
          "default": [
            "main",
            "dev",
            "beta"
          ],
          "items": {
            "type": "string"
          },
          "description": "Branches where manually switching tasks should offer to switch to or create a task branch. Matching is case-insensitive."
        },
        "copilot-tracker.taskBranchNamePrefix": {
          "type": "string",
          "default": "",
          "description": "Optional prefix used for suggested task branch names when creating a branch from the task switch prompt."
        }
      }
    }
  },
  "activationEvents": [
    "*"
  ],
  "dependencies": {
    "@copilot-tracker/shared": "workspace:*"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "~26.1.2",
    "@types/vscode": "^1.125.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^3.2.0",
    "esbuild": "^0.28.1",
    "eslint": "^10.8.0",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.65.0"
  },
  "engines": {
    "vscode": "^1.125.0"
  }
}
